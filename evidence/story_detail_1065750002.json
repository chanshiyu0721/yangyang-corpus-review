          "talkId": 1,
          "talkIndex": 0
        },
        {
          "id": 2,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "35TUOZUI_3_2",
          "text": "就近搭建营帐，重伤员留院治疗，轻伤员移入营帐内，安排医师照料。",
          "texts": {
            "zh-Hans": "就近搭建营帐，重伤员留院治疗，轻伤员移入营帐内，安排医师照料。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "QuestNodeData:/Data/Condition/AddOptions/0/Option/Type/Flow -> 剧情_3_5_支线_不白之罪_5_1:/2/TalkItems/1/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_支线_不白之罪",
            "flowId": 5,
            "stateId": 1
          },
          "talkId": 2,
          "talkIndex": 1
        },
        {
          "id": 3,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "35TUOZUI_3_3",
          "text": "今州的药物和人手支援马上就到，请大家再坚持一下。",
          "texts": {
            "zh-Hans": "今州的药物和人手支援马上就到，请大家再坚持一下。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "QuestNodeData:/Data/Condition/AddOptions/0/Option/Type/Flow -> 剧情_3_5_支线_不白之罪_5_1:/2/TalkItems/2/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_支线_不白之罪",
            "flowId": 5,
            "stateId": 1
          },
          "talkId": 3,
          "talkIndex": 2
        },
        {
          "id": 4,
          "speaker": "急切的定玄卫",
          "speakers": {
            "zh-Hans": "急切的定玄卫"
          },
          "speakerId": 750597,
          "textKey": "35TUOZUI_3_4",
          "text": "秧秧骑使，新增三处失控机傀活跃坐标，都在城外！现在只有两支小队可以派遣。",
          "texts": {
            "zh-Hans": "秧秧骑使，新增三处失控机傀活跃坐标，都在城外！现在只有两支小队可以派遣。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "QuestNodeData:/Data/Condition/AddOptions/0/Option/Type/Flow -> 剧情_3_5_支线_不白之罪_5_1:/2/TalkItems/3/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_支线_不白之罪",
            "flowId": 5,
            "stateId": 1
          },
          "talkId": 4,
          "talkIndex": 3
        },
        {
          "id": 5,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "35TUOZUI_3_5",
          "text": "让这两支队伍出城作战，另遣一名斥候到第三处坐标追踪机傀，等其他小队任务结束再与其汇合。",
          "texts": {
            "zh-Hans": "让这两支队伍出城作战，另遣一名斥候到第三处坐标追踪机傀，等其他小队任务结束再与其汇合。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "QuestNodeData:/Data/Condition/AddOptions/0/Option/Type/Flow -> 剧情_3_5_支线_不白之罪_5_1:/2/TalkItems/4/TidTalk",
          "flow": {
