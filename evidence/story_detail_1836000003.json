            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000003/Data/89/Flow -> 剧情_3_6_神宫幻境_44_1:/5/TalkItems/4/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 6,
          "speaker": "小玉",
          "speakers": {
            "zh-Hans": "小玉"
          },
          "speakerId": 400025,
          "textKey": "Main_Mengzhou_3_6_330_10",
          "text": "这的天空从低到高分了好几层。这里是「人境」，再往上去，就是「地境」了。",
          "texts": {
            "zh-Hans": "这的天空从低到高分了好几层。这里是「人境」，再往上去，就是「地境」了。"
          },
