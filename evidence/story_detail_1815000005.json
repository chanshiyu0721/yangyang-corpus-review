        {
          "id": 10,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_15",
          "text": "别把我和那个眼界狭隘的女人相提并论，「花间傀」眼中只有梦州城那片浮华的乐土。",
          "texts": {
            "zh-Hans": "别把我和那个眼界狭隘的女人相提并论，「花间傀」眼中只有梦州城那片浮华的乐土。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/9/TidTalk",
          "flow": {
