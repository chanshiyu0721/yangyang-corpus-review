          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/14/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 15,
          "talkIndex": 14,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
