        {
          "id": 17,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_20",
          "text": "这几天……除了调查琢钧堂外，我还亲自去了梦州边庭一趟。",
          "texts": {
            "zh-Hans": "这几天……除了调查琢钧堂外，我还亲自去了梦州边庭一趟。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [
            {
              "speaker": "漂泊者_选项",
              "speakers": {
                "zh-Hans": "漂泊者_选项"
              },
              "textKey": "Main_Mengzhou_3_6_650_21",
              "text": "又去闯边庭了啊……",
              "texts": {
                "zh-Hans": "又去闯边庭了啊……"
              },
              "textSource": "rebuild_v2_flowstate",
              "jumpToId": null,
