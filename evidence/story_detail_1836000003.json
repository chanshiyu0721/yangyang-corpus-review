          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000003/Data/89/Flow -> 剧情_3_6_神宫幻境_44_1:/5/TalkItems/6/TidTalk",
          "flow": {
