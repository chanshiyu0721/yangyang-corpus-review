          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "QuestNodeData:/Data/EnterActions/1/Params -> 剧情_通缉poi主线_30_1:/1/TalkItems/0/TidTalk",
          "flow": {
