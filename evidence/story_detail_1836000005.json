        },
        {
          "id": 12,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_15",
          "text": "……是吗？在神宫分开后就没再现身了……他是江湖上出了名的神出鬼没，可能哪天就又冒出来了。",
          "texts": {
            "zh-Hans": "……是吗？在神宫分开后就没再现身了……他是江湖上出了名的神出鬼没，可能哪天就又冒出来了。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/10/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 11,
          "talkIndex": 10,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/10/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 13,
          "speaker": "漂泊者",
          "speakers": {
            "zh-Hans": "漂泊者"
          },
          "speakerId": 750088,
          "textKey": "Main_Mengzhou_3_6_650_16",
          "text": "我也相信，他会平安的。",
          "texts": {
            "zh-Hans": "我也相信，他会平安的。"
          },
          "textSource": "rebuild_v2_flowstate",
