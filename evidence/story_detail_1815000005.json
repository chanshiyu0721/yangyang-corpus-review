            "actionName": "JumpTalk",
            "actionIndex": 0,
            "actionId": 5000097,
            "targetTalkId": 13
          },
          "targetTalkId": 13,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/9/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 11,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_16",
          "text": "噢，一个有趣的名字。我听过今州的这个小组织，明明连灵魂的本质都不曾触碰，却用记忆塑造出可笑的假象。",
          "texts": {
            "zh-Hans": "噢，一个有趣的名字。我听过今州的这个小组织，明明连灵魂的本质都不曾触碰，却用记忆塑造出可笑的假象。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/10/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 11,
          "talkIndex": 10,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/10/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
