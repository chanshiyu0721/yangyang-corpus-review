          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_Mengzhou_3_6_650_24",
          "text": "之前边庭承诺的支援倒是得到了兑现，近期就会有一批人员和物资从梦州城过来。今州的新一批援助物资也到了。",
          "texts": {
            "zh-Hans": "之前边庭承诺的支援倒是得到了兑现，近期就会有一批人员和物资从梦州城过来。今州的新一批援助物资也到了。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/18/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 19,
          "talkIndex": 18,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/18/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
