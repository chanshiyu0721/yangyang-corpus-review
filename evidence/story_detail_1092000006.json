          "speakers": {
            "zh-Hans": "漂泊者_选项"
          },
          "speakerId": null,
          "textKey": "Main_HuangLong_SYYLFML_20_6",
          "text": "（问问秧秧的近况）",
          "texts": {
            "zh-Hans": "（问问秧秧的近况）"
          },
          "textSource": "manual-override",
          "options": [],
          "jumpToId": null,
          "playVoice": false,
          "sourcePath": "search_v2:126:157763",
