          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000003/Data/89/Flow -> 剧情_3_6_神宫幻境_44_1:/5/TalkItems/5/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 44,
            "stateId": 1
          },
          "talkId": 6,
          "talkIndex": 5,
