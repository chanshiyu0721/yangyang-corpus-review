            "stateId": 1
          },
          "talkId": 5,
          "talkIndex": 4
        },
        {
          "id": 6,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "35TUOZUI_3_6",
          "text": "请大家务必珍重自身安全。",
          "texts": {
            "zh-Hans": "请大家务必珍重自身安全。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "QuestNodeData:/Data/Condition/AddOptions/0/Option/Type/Flow -> 剧情_3_5_支线_不白之罪_5_1:/2/TalkItems/5/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_支线_不白之罪",
