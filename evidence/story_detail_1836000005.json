            "stateId": 1
          },
          "talkId": 16,
          "talkIndex": 15,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/15/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 18,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_22",
          "text": "唉，上次在今州还是边喝茶边等，这次……直接吃了闭门羹，说是梦州令尹不便见客。",
          "texts": {
            "zh-Hans": "唉，上次在今州还是边喝茶边等，这次……直接吃了闭门羹，说是梦州令尹不便见客。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/16/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 17,
          "talkIndex": 16,
          "manualOverrideLine": {
            "origin": "preview-detail",
