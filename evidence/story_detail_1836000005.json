        },
        {
          "id": 2,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_1",
          "text": "……太好了，你们都没事。秧秧，快凑近点给姐姐瞧瞧，有没有哪里伤到了？",
          "texts": {
            "zh-Hans": "……太好了，你们都没事。秧秧，快凑近点给姐姐瞧瞧，有没有哪里伤到了？"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/0/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 1,
          "talkIndex": 0,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/0/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 3,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_Mengzhou_3_6_650_2",
          "text": "姐姐，我真的没什么……漂泊者和清宵司骑才是一路深入了神宫之中，遇到了很多危险。",
          "texts": {
            "zh-Hans": "姐姐，我真的没什么……漂泊者和清宵司骑才是一路深入了神宫之中，遇到了很多危险。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [
            {
              "speaker": "漂泊者_选项",
              "speakers": {
                "zh-Hans": "漂泊者_选项"
              },
              "textKey": "Main_Mengzhou_3_6_650_3",
              "text": "秧秧这次表现得特别可靠。",
              "texts": {
                "zh-Hans": "秧秧这次表现得特别可靠。"
              },
              "textSource": "rebuild_v2_flowstate",
              "jumpToId": null,
              "talkId": 2,
              "talkIndex": 1,
              "optionIndex": 0,
              "manualOverrideLine": {
                "origin": "preview-detail",
                "manualInserted": false,
                "sourcePath": "",
                "flowKey": "",
                "flowKeys": []
              }
            },
            {
              "speaker": "漂泊者_选项",
              "speakers": {
                "zh-Hans": "漂泊者_选项"
              },
              "textKey": "Main_Mengzhou_3_6_650_4",
              "text": "她已经是玄方城的中流砥柱了。",
              "texts": {
                "zh-Hans": "她已经是玄方城的中流砥柱了。"
              },
              "textSource": "rebuild_v2_flowstate",
              "jumpToId": null,
              "talkId": 2,
              "talkIndex": 1,
              "optionIndex": 1,
              "manualOverrideLine": {
                "origin": "preview-detail",
                "manualInserted": false,
                "sourcePath": "",
                "flowKey": "",
                "flowKeys": []
              }
            }
          ],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/1/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 2,
          "talkIndex": 1,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/1/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 4,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_Mengzhou_3_6_650_5",
          "text": "漂泊者，别在姐姐面前这么夸我……",
          "texts": {
            "zh-Hans": "漂泊者，别在姐姐面前这么夸我……"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/2/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 3,
          "talkIndex": 2,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/2/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 5,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_6",
          "text": "好啦好啦，你们就不要互相捧对方了。接下来——我该以「昭明商会」理事的身份来谈正事了。",
          "texts": {
            "zh-Hans": "好啦好啦，你们就不要互相捧对方了。接下来——我该以「昭明商会」理事的身份来谈正事了。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/3/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 4,
          "talkIndex": 3,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/3/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 6,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_8",
          "text": "回梦州城后，我用商会的人脉去调查了木禺这个人的底细，也和琢钧堂总舵进行了接触。",
          "texts": {
            "zh-Hans": "回梦州城后，我用商会的人脉去调查了木禺这个人的底细，也和琢钧堂总舵进行了接触。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/4/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 5,
          "talkIndex": 4,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/4/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 7,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_9",
          "text": "木禺确是两百年前负责设计渊城的机关术天才，是琢钧堂资历极老的成员，和梦州的华胥研究院也曾有深度合作。",
          "texts": {
            "zh-Hans": "木禺确是两百年前负责设计渊城的机关术天才，是琢钧堂资历极老的成员，和梦州的华胥研究院也曾有深度合作。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/5/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 6,
          "talkIndex": 5,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/5/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 8,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_10",
          "text": "二十多年前，他本预定接替「花间傀」成为下任堂主，却宣称脱离组织，其后便不知去向了。",
          "texts": {
            "zh-Hans": "二十多年前，他本预定接替「花间傀」成为下任堂主，却宣称脱离组织，其后便不知去向了。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/6/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 7,
          "talkIndex": 6,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/6/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 9,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_Mengzhou_3_6_650_11",
          "text": "那之后……木禺多半是化名来玄方地界蛰伏，筹备他的计划了。",
          "texts": {
            "zh-Hans": "那之后……木禺多半是化名来玄方地界蛰伏，筹备他的计划了。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/7/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 8,
          "talkIndex": 7,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/7/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 10,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_12",
          "text": "琢钧堂明面上完全和他划清了界限，还表示愿意提供木禺的相关资料，协助商会调查。",
          "texts": {
            "zh-Hans": "琢钧堂明面上完全和他划清了界限，还表示愿意提供木禺的相关资料，协助商会调查。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/8/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 9,
          "talkIndex": 8,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/8/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 11,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_13",
          "text": "但我们知道，木禺暗地还通过那位线人从琢钧堂获得过支持呢。对了，你见到「鬼猫挈灯」了吗？",
          "texts": {
            "zh-Hans": "但我们知道，木禺暗地还通过那位线人从琢钧堂获得过支持呢。对了，你见到「鬼猫挈灯」了吗？"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [
            {
              "speaker": "漂泊者_选项",
              "speakers": {
                "zh-Hans": "漂泊者_选项"
              },
              "textKey": "Main_Mengzhou_3_6_650_14",
              "text": "（告知穗穗关于景燃的事。）",
              "texts": {
                "zh-Hans": "（告知穗穗关于景燃的事。）"
              },
              "textSource": "rebuild_v2_flowstate",
              "jumpToId": null,
              "talkId": 10,
              "talkIndex": 9,
              "optionIndex": 0,
              "manualOverrideLine": {
