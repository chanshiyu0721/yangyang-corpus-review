          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_405_7",
          "text": "你明明比谁都清楚，普通人的性命相较你们这样的共鸣者有多脆弱。不久后，玄方城会崩塌，他们都会死。",
          "texts": {
            "zh-Hans": "你明明比谁都清楚，普通人的性命相较你们这样的共鸣者有多脆弱。不久后，玄方城会崩塌，他们都会死。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/3/Flow -> 剧情_3_6_神宫幻境_67_1:/3/TalkItems/6/TidTalk",
