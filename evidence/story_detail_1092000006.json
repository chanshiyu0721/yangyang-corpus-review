      "dialogues": [
        {
          "id": 1,
          "speaker": "炽霞",
          "speakers": {
            "zh-Hans": "炽霞"
          },
          "speakerId": 101,
          "textKey": "Main_HuangLong_SYYLFML_30_4",
          "text": "喂——！秧秧，该走啦！",
          "texts": {
