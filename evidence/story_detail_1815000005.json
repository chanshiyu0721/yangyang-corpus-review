        },
        {
          "id": 2,
          "speaker": "漂泊者",
          "speakers": {
            "zh-Hans": "漂泊者"
          },
          "speakerId": 750088,
          "textKey": "Main_Mengzhou_3_6_391_5",
          "text": "木禺……你已将残响植入了机傀之中，却还要派出机傀袭击它们吗？",
          "texts": {
            "zh-Hans": "木禺……你已将残响植入了机傀之中，却还要派出机傀袭击它们吗？"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/1/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 2,
          "talkIndex": 1,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/1/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 3,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_6",
          "text": "因为，它们是失败的实验品。",
          "texts": {
            "zh-Hans": "因为，它们是失败的实验品。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/2/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 3,
          "talkIndex": 2,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/2/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 4,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_7",
          "text": "意识劣化，记忆损失，自我认知淡薄，甚至无法自由行动……是时候换一批新的样本了。",
          "texts": {
            "zh-Hans": "意识劣化，记忆损失，自我认知淡薄，甚至无法自由行动……是时候换一批新的样本了。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/3/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 4,
          "talkIndex": 3,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/3/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 5,
          "speaker": "清宵",
          "speakers": {
            "zh-Hans": "清宵"
          },
          "speakerId": 350141,
          "textKey": "Main_Mengzhou_3_6_391_8",
          "text": "你亵渎无辜者的生命，把他们当作实验的耗材。",
          "texts": {
            "zh-Hans": "你亵渎无辜者的生命，把他们当作实验的耗材。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/4/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 5,
          "talkIndex": 4,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/4/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 6,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_9",
          "text": "我更愿称其为……“合理的利用”。",
          "texts": {
            "zh-Hans": "我更愿称其为……“合理的利用”。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/5/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 6,
          "talkIndex": 5,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/5/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 7,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_10",
          "text": "他们本就是散落在渊城遗址的残响，即使放任不管，也很可能会演变成残象。",
          "texts": {
            "zh-Hans": "他们本就是散落在渊城遗址的残响，即使放任不管，也很可能会演变成残象。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/6/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 7,
          "talkIndex": 6,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/6/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 8,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_11",
          "text": "但现在他们成了一项伟大实验的样本——如果残响能融入机傀之躯，那就可以打破生死界限，创造出恒久不灭的生命。",
          "texts": {
            "zh-Hans": "但现在他们成了一项伟大实验的样本——如果残响能融入机傀之躯，那就可以打破生死界限，创造出恒久不灭的生命。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/7/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 8,
          "talkIndex": 7,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/7/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 9,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_12",
          "text": "躯体衰朽，那就更换躯体，只要保有意识，便可永续存在。届时，生死将没有差异，死者亦可复生。",
          "texts": {
            "zh-Hans": "躯体衰朽，那就更换躯体，只要保有意识，便可永续存在。届时，生死将没有差异，死者亦可复生。"
          },
