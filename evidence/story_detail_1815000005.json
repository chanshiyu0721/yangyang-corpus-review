          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_20",
          "text": "增加一座咎庭的负担尚能支持，但如果两座呢，三座呢？即使他们能撑住，又要付出什么样的代价？",
          "texts": {
            "zh-Hans": "增加一座咎庭的负担尚能支持，但如果两座呢，三座呢？即使他们能撑住，又要付出什么样的代价？"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
