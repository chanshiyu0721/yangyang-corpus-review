            "stateId": 1
          },
          "talkId": 6,
          "talkIndex": 5
        },
        {
          "id": 7,
          "speaker": "慌乱的定玄卫",
          "speakers": {
            "zh-Hans": "慌乱的定玄卫"
          },
          "speakerId": 750596,
          "textKey": "35TUOZUI_3_7",
          "text": "秧秧骑使，还有阵亡军士的抚恤安排……",
          "texts": {
            "zh-Hans": "秧秧骑使，还有阵亡军士的抚恤安排……"
