        {
          "id": 23,
          "speaker": "椋羽",
          "speakers": {
            "zh-Hans": "椋羽"
          },
          "speakerId": 350101,
          "textKey": "Main_Mengzhou_3_6_340_9",
          "text": "没关系，这点伤已经养得差不多了，我只是遵从医嘱在军策府静养。",
          "texts": {
