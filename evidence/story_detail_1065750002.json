          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "QuestNodeData:/Data/Condition/AddOptions/0/Option/Type/Flow -> 剧情_3_5_支线_不白之罪_5_1:/2/TalkItems/6/TidTalk",
          "flow": {
