          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_17",
          "text": "<te href=750058>偃师</te>……一个不入流的傀儡师。只是指点过几下的工夫，我便能从他眼中看到那份沉溺于过往的软弱。",
          "texts": {
            "zh-Hans": "<te href=750058>偃师</te>……一个不入流的傀儡师。只是指点过几下的工夫，我便能从他眼中看到那份沉溺于过往的软弱。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/11/TidTalk",
