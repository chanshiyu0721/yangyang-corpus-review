          },
          "speakerId": 750596,
          "textKey": "35TUOZUI_3_1",
          "text": "秧秧骑使，华胥研究院伤员众多、床位不足、药物告急！",
          "texts": {
            "zh-Hans": "秧秧骑使，华胥研究院伤员众多、床位不足、药物告急！"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "QuestNodeData:/Data/Condition/AddOptions/0/Option/Type/Flow -> 剧情_3_5_支线_不白之罪_5_1:/2/TalkItems/0/TidTalk",
          "flow": {
