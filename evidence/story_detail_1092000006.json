          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/3/Flow -> 剧情_3_5_拉海洛今州_50_1:/5/TalkItems/9/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 1
          },
          "talkId": 10,
          "talkIndex": 9,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/3/Flow -> 剧情_3_5_拉海洛今州_50_1:/5/TalkItems/9/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 2,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_HuangLong_SYYLFML_30_5",
          "text": "嗯，我就来。",
          "texts": {
            "zh-Hans": "嗯，我就来。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/3/Flow -> 剧情_3_5_拉海洛今州_50_1:/5/TalkItems/10/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 1
          },
          "talkId": 11,
          "talkIndex": 10,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/3/Flow -> 剧情_3_5_拉海洛今州_50_1:/5/TalkItems/10/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 3,
          "speaker": "炽霞",
          "speakers": {
            "zh-Hans": "炽霞"
          },
          "speakerId": 101,
          "textKey": "Main_HuangLong_SYYLFML_33_6",
          "text": "我看看我看看……穿过前面的哨卡就是玄方地界了。没想到一路跟着线索跑，最后居然会到这么远的地方来。",
          "texts": {
            "zh-Hans": "我看看我看看……穿过前面的哨卡就是玄方地界了。没想到一路跟着线索跑，最后居然会到这么远的地方来。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/0/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 2
          },
          "talkId": 1,
          "talkIndex": 0,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/0/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 4,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_HuangLong_SYYLFML_33_7",
          "text": "那些失踪的人，最后都来到了这里……",
          "texts": {
            "zh-Hans": "那些失踪的人，最后都来到了这里……"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/1/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 2
          },
          "talkId": 2,
          "talkIndex": 1,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/1/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 5,
          "speaker": "炽霞",
          "speakers": {
            "zh-Hans": "炽霞"
          },
          "speakerId": 101,
          "textKey": "Main_HuangLong_SYYLFML_33_8",
          "text": "这也要多亏秧秧你的<te href=750055>流息</te>啦！要是没你把那些蛛丝马迹串联起来，我们不知要在今州兜多少圈呢！",
          "texts": {
            "zh-Hans": "这也要多亏秧秧你的<te href=750055>流息</te>啦！要是没你把那些蛛丝马迹串联起来，我们不知要在今州兜多少圈呢！"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/2/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 2
          },
          "talkId": 3,
          "talkIndex": 2,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/2/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 6,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_HuangLong_SYYLFML_33_9",
          "text": "太夸张了，炽霞……按今巡尉的调查结果，他们都是因各种原因要往梦州去，而玄方地界就在必经之路上。",
          "texts": {
            "zh-Hans": "太夸张了，炽霞……按今巡尉的调查结果，他们都是因各种原因要往梦州去，而玄方地界就在必经之路上。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/3/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 2
          },
          "talkId": 4,
          "talkIndex": 3,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/3/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 7,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_HuangLong_SYYLFML_33_10",
          "text": "结果既没有人去到梦州，也无人折返回来……可如果我没记错的话，玄方地界——",
          "texts": {
            "zh-Hans": "结果既没有人去到梦州，也无人折返回来……可如果我没记错的话，玄方地界——"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/4/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 2
          },
          "talkId": 5,
          "talkIndex": 4,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/4/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 8,
          "speaker": "炽霞",
          "speakers": {
            "zh-Hans": "炽霞"
          },
          "speakerId": 101,
          "textKey": "Main_HuangLong_SYYLFML_33_11",
          "text": "去了不就知道发生了什么嘛。我已经跟上头申请过调查令了，只要给哨卡的人看过文书，应该就会放我们进城了。",
          "texts": {
            "zh-Hans": "去了不就知道发生了什么嘛。我已经跟上头申请过调查令了，只要给哨卡的人看过文书，应该就会放我们进城了。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/5/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 2
          },
          "talkId": 6,
          "talkIndex": 5,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/5/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 9,
          "speaker": "炽霞",
          "speakers": {
            "zh-Hans": "炽霞"
          },
          "speakerId": 101,
          "textKey": "Main_HuangLong_SYYLFML_33_12",
          "text": "呼……我还是头一次出这么远的外勤呢。总之，要把那些下落不明的人平安带回来！对吧，秧秧？",
          "texts": {
            "zh-Hans": "呼……我还是头一次出这么远的外勤呢。总之，要把那些下落不明的人平安带回来！对吧，秧秧？"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/6/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 2
          },
          "talkId": 7,
          "talkIndex": 6,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/6/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 10,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_HuangLong_SYYLFML_33_13",
          "text": "嗯，我们走吧。",
          "texts": {
            "zh-Hans": "嗯，我们走吧。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/7/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 2
          },
          "talkId": 8,
          "talkIndex": 7,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/4/Flow -> 剧情_3_5_拉海洛今州_50_2:/7/TalkItems/7/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 11,
          "speaker": "炽霞",
          "speakers": {
            "zh-Hans": "炽霞"
          },
          "speakerId": 101,
          "textKey": "Main_HuangLong_SYYLFML_40_1",
          "text": "话说，刚才你在那一个人看些什么呀？总感觉你看的时候一直在笑……好少见你露出那种表情哦。",
          "texts": {
            "zh-Hans": "话说，刚才你在那一个人看些什么呀？总感觉你看的时候一直在笑……好少见你露出那种表情哦。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:192000006/Data/6/Flow -> 剧情_3_5_拉海洛今州_50_3:/1/TalkItems/0/TidTalk",
          "flow": {
            "flowListName": "剧情_3_5_拉海洛今州",
            "flowId": 50,
            "stateId": 3
          },
          "talkId": 1,
          "talkIndex": 0,
          "manualOverrideLine": {
            "origin": "preview-detail",
            "manualInserted": false,
            "sourcePath": "PlotHandBook:192000006/Data/6/Flow -> 剧情_3_5_拉海洛今州_50_3:/1/TalkItems/0/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 12,
          "speaker": "秧秧",
          "speakers": {
            "zh-Hans": "秧秧"
          },
          "speakerId": 108,
          "textKey": "Main_HuangLong_SYYLFML_40_2",
          "text": "咦？我平时应该也没有那么严肃……吧？",
          "texts": {
            "zh-Hans": "咦？我平时应该也没有那么严肃……吧？"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
