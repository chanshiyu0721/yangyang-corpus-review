          ],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/9/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 10,
          "talkIndex": 9,
          "manualOverrideLine": {
