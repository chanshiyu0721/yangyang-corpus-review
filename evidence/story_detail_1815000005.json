          }
        },
        {
          "id": 13,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_18",
          "text": "还是换个你们更关心的话题吧。比如……现实中的军策府？",
          "texts": {
            "zh-Hans": "还是换个你们更关心的话题吧。比如……现实中的军策府？"
