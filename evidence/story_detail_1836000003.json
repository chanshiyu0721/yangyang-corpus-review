            "zh-Hans": "清宵"
          },
          "speakerId": 350141,
          "textKey": "Main_Mengzhou_3_6_330_6",
          "text": "渊城山门和此处相距甚远，而且，当时你明明停止了活动。",
          "texts": {
            "zh-Hans": "渊城山门和此处相距甚远，而且，当时你明明停止了活动。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000003/Data/89/Flow -> 剧情_3_6_神宫幻境_44_1:/5/TalkItems/3/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 44,
