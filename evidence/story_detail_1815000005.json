          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/3/Flow -> 剧情_3_6_神宫幻境_67_1:/3/TalkItems/5/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
