            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 5,
          "speaker": "小玉",
          "speakers": {
            "zh-Hans": "小玉"
          },
          "speakerId": 400025,
          "textKey": "Main_Mengzhou_3_6_330_17",
          "text": "唔，其实当时我能源不足关机了，幸亏醒来后从其他机傀那找到了备用能源，这才能一路飞过来。",
          "texts": {
            "zh-Hans": "唔，其实当时我能源不足关机了，幸亏醒来后从其他机傀那找到了备用能源，这才能一路飞过来。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000003/Data/89/Flow -> 剧情_3_6_神宫幻境_44_1:/5/TalkItems/4/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 44,
            "stateId": 1
