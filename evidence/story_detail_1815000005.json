        {
          "id": 16,
          "speaker": "漂泊者",
          "speakers": {
            "zh-Hans": "漂泊者"
          },
          "speakerId": 750088,
          "textKey": "Main_Mengzhou_3_6_391_21",
          "text": "你小看了玄方城的人们，正如你从未理解他们为何而战。",
          "texts": {
            "zh-Hans": "你小看了玄方城的人们，正如你从未理解他们为何而战。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/15/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 16,
          "talkIndex": 15,
