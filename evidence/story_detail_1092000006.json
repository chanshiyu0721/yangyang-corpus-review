        },
        {
          "id": 11,
          "speaker": "{PlayerName}",
          "speakers": {
            "zh-Hans": "{PlayerName}"
          },
          "speakerId": null,
          "textKey": "Main_HuangLong_SYYLFML_20_13",
          "text": "今州的大家过得怎么样？那次追月节过后，似乎就很难有机会与大家重聚了。",
          "texts": {
            "zh-Hans": "今州的大家过得怎么样？那次追月节过后，似乎就很难有机会与大家重聚了。"
          },
          "textSource": "manual-override",
          "options": [],
          "jumpToId": null,
          "playVoice": false,
          "sourcePath": "search_v2:126:157764",
          "manualOverrideLine": {
            "origin": "search-api",
            "manualInserted": true,
            "sourcePath": "search_v2:126:157764",
            "flowKey": "剧情_3_5_拉海洛今州_4_1",
            "flowKeys": [
              "剧情_3_5_拉海洛今州_4_1"
            ]
          }
        },
        {
          "id": 12,
          "speaker": "{PlayerName}",
          "speakers": {
            "zh-Hans": "{PlayerName}"
          },
          "speakerId": null,
          "textKey": "Main_HuangLong_SYYLFML_20_14",
          "text": "我的脚步……不知不觉已经迈出很远了。",
          "texts": {
            "zh-Hans": "我的脚步……不知不觉已经迈出很远了。"
          },
          "textSource": "manual-override",
          "options": [],
          "jumpToId": null,
          "playVoice": false,
          "sourcePath": "search_v2:126:157765",
          "manualOverrideLine": {
            "origin": "search-api",
            "manualInserted": true,
            "sourcePath": "search_v2:126:157765",
            "flowKey": "剧情_3_5_拉海洛今州_4_1",
            "flowKeys": [
              "剧情_3_5_拉海洛今州_4_1"
            ]
          }
        },
        {
          "id": 13,
          "speaker": "{PlayerName}",
          "speakers": {
            "zh-Hans": "{PlayerName}"
          },
          "speakerId": null,
          "textKey": "Main_HuangLong_SYYLFML_20_15",
          "text": "有时我也会想着……要不要偶尔停歇下来，回到熟悉的地方。可每当冒出这种念头的时候，总有新的麻烦找上门来……",
          "texts": {
            "zh-Hans": "有时我也会想着……要不要偶尔停歇下来，回到熟悉的地方。可每当冒出这种念头的时候，总有新的麻烦找上门来……"
          },
          "textSource": "manual-override",
          "options": [],
          "jumpToId": null,
          "playVoice": false,
          "sourcePath": "search_v2:126:157766",
          "manualOverrideLine": {
            "origin": "search-api",
            "manualInserted": true,
            "sourcePath": "search_v2:126:157766",
            "flowKey": "剧情_3_5_拉海洛今州_4_1",
            "flowKeys": [
              "剧情_3_5_拉海洛今州_4_1"
            ]
          }
        },
        {
          "id": 14,
          "speaker": "{PlayerName}",
          "speakers": {
            "zh-Hans": "{PlayerName}"
          },
          "speakerId": null,
          "textKey": "Main_HuangLong_SYYLFML_20_17",
          "text": "秧秧，最近你还好吗？",
          "texts": {
            "zh-Hans": "秧秧，最近你还好吗？"
          },
          "textSource": "manual-override",
          "options": [],
          "jumpToId": null,
          "playVoice": false,
          "sourcePath": "search_v2:126:157767",
          "manualOverrideLine": {
            "origin": "search-api",
            "manualInserted": true,
            "sourcePath": "search_v2:126:157767",
            "flowKey": "剧情_3_5_拉海洛今州_4_1",
            "flowKeys": [
              "剧情_3_5_拉海洛今州_4_1"
            ]
          }
        },
        {
          "id": 15,
          "speaker": "{PlayerName}",
          "speakers": {
            "zh-Hans": "{PlayerName}"
          },
          "speakerId": null,
          "textKey": "Main_HuangLong_SYYLFML_20_18",
          "text": "每当收到你的来信的时候，我都能意识到，自己离起点已经迈出了多远的距离。我相信我不在的这段时间里，你肯定也在朝着自己的目标努力……下次见面的时候，我们能够分享彼此的成果就好了。",
          "texts": {
            "zh-Hans": "每当收到你的来信的时候，我都能意识到，自己离起点已经迈出了多远的距离。我相信我不在的这段时间里，你肯定也在朝着自己的目标努力……下次见面的时候，我们能够分享彼此的成果就好了。"
          },
          "textSource": "manual-override",
          "options": [],
          "jumpToId": null,
          "playVoice": false,
          "sourcePath": "search_v2:126:157768",
          "manualOverrideLine": {
