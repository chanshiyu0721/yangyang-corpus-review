        {
          "id": 17,
          "speaker": "木禺虚影",
          "speakers": {
            "zh-Hans": "木禺虚影"
          },
          "speakerId": 400019,
          "textKey": "Main_Mengzhou_3_6_391_22",
          "text": "呵，你们笃信脆弱的情感和意志，却不懂得人只有靠先进的技术才能掌握自己的命运。",
          "texts": {
            "zh-Hans": "呵，你们笃信脆弱的情感和意志，却不懂得人只有靠先进的技术才能掌握自己的命运。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/16/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 17,
          "talkIndex": 16,
