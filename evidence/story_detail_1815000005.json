          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:915000005/Data/1/Flow -> 剧情_3_6_神宫幻境_65_1:/3/TalkItems/12/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_神宫幻境",
            "flowId": 65,
            "stateId": 1
          },
          "talkId": 13,
          "talkIndex": 12,
          "manualOverrideLine": {
