          "speakerId": 750088,
          "textKey": "Main_Mengzhou_3_6_647_1",
          "text": "（穗穗似乎有事要联络我们，先去军策府和秧秧会合吧。）",
          "texts": {
            "zh-Hans": "（穗穗似乎有事要联络我们，先去军策府和秧秧会合吧。）"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
