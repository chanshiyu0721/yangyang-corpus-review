            "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/16/TidTalk",
            "flowKey": "",
            "flowKeys": []
          }
        },
        {
          "id": 19,
          "speaker": "穗穗（通讯中）",
          "speakers": {
            "zh-Hans": "穗穗（通讯中）"
          },
          "speakerId": 800498,
          "textKey": "Main_Mengzhou_3_6_650_23",
          "text": "玄方地界接连出了大事，梦州边庭却是一片平静，态度实在让人生疑。",
          "texts": {
            "zh-Hans": "玄方地界接连出了大事，梦州边庭却是一片平静，态度实在让人生疑。"
          },
          "textSource": "rebuild_v2_flowstate",
          "options": [],
          "jumpToId": null,
          "playVoice": true,
          "sourcePath": "PlotHandBook:936000005/Data/4/Flow -> 剧情_3_6_后日谈_3_1:/3/TalkItems/17/TidTalk",
          "flow": {
            "flowListName": "剧情_3_6_后日谈",
            "flowId": 3,
            "stateId": 1
          },
          "talkId": 18,
          "talkIndex": 17,
          "manualOverrideLine": {
            "origin": "preview-detail",
